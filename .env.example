# --- Banco de dados ---
# Producao: Supabase, modo "Session pooler" (Connect > Direto > Agrupador de
# sessoes). IMPORTANTE: NAO use a connection string com o usuario "postgres"
# que o Supabase mostra por padrao — essa role tem BYPASSRLS (ignora as
# politicas de RLS de sql/rls_policies.sql silenciosamente, sem erro nenhum).
# Crie uma role dedicada pro app antes de trocar isto (rode uma vez, com a
# connection string do "postgres", via psql ou script python):
#
#   CREATE ROLE fichabase_app LOGIN PASSWORD 'GERE_UMA_SENHA_FORTE' NOSUPERUSER NOBYPASSRLS;
#   GRANT USAGE ON SCHEMA public TO fichabase_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO fichabase_app;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO fichabase_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO fichabase_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO fichabase_app;
#
# O usuario na connection string vira "fichabase_app.<project-ref>" (mesmo
# padrao do "postgres.<project-ref>" que o Supabase mostra):
DATABASE_URL=postgresql+psycopg://fichabase_app.xxxxxxxxxxxx:SENHA@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres

# Alternativa para prototipar sem Postgres instalado (nao usar em producao: nao
# aguenta multiplos usuarios remotos gravando ao mesmo tempo):
# DATABASE_URL=sqlite:///./fichabase.db

# --- Autenticacao ---
# Chave usada para assinar o cookie de sessao do streamlit-authenticator.
# Gere uma string aleatoria longa (ex: python -c "import secrets; print(secrets.token_hex(32))").
AUTH_COOKIE_KEY=troque_esta_chave

LOG_LEVEL=INFO

# --- E-mail (Resend) ---
# Usado pra mandar a senha provisoria quando um usuario novo e criado
# (pages/usuarios.py). Sem isso preenchido, o app mostra a senha na tela em
# vez de enviar por email (ver fichabase/email.py).
# 1. Crie conta em resend.com (gratuito ate 3.000 emails/mes).
# 2. Verifique um dominio seu (Resend > Domains) — sem isso, so entrega
#    email pro proprio dono da conta Resend, nao pra terceiros.
# 3. Resend > API Keys > Create API Key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=FichaBase <naoresponda@seudominio.com.br>

# --- Storage de fotos (Supabase Storage) ---
# Usado pra fotos de fichas tecnicas (upload/camera, pages/fichas_tecnicas.py
# via fichabase/fotos.py). Disco local nao funciona em producao: o Streamlit
# Community Cloud apaga o disco a cada reinicio/deploy.
# Valores em Project Settings > API no painel do Supabase.
# CUIDADO: service_role da acesso total ao projeto (ignora RLS) — nunca
# comitar isso nem usar a "anon key" no lugar dela (upload falharia).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_STORAGE_BUCKET=fotos-fichas
