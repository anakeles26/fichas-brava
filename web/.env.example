# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel
# (Project Settings > Environment Variables). Valores em Supabase > Project Settings > API.
# A chave aqui é a PÚBLICA (publishable / anon). A secreta (service role) nunca vai neste app.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Só no servidor (NUNCA com prefixo NEXT_PUBLIC_): permite à gestão criar logins pela tela
# Usuários. Supabase > Project Settings > API > service_role. Na Vercel, marque como Sensitive.
SUPABASE_SERVICE_ROLE_KEY=
